# Copie este arquivo para .env e preencha com seus dados (NAO suba o .env para o GitHub)
# Para rodar LOCALMENTE. No GitHub Actions, use os Secrets do repositorio.

# Token do seu bot do Telegram (criado pelo @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyz

# ID do canal/chat para onde os sinais serao enviados
# Para canal publico pode usar @nomedocanal; para canal privado use o ID numerico (ex: -1001234567890)
TELEGRAM_CHAT_ID=@meu_canal_de_investimentos

# (Opcional) Score minimo para um ativo aparecer no relatorio (0 a 100)
MIN_SCORE=60
